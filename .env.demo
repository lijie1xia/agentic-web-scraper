# 阿里云 Qwen API
QWEN_API_KEY=your-qwen-api-key

# 本地/自定义 OpenAI 兼容模型
LOCAL_API_KEY=your-local-api-key
LOCAL_BASE_URL=http://your-server:8000/v1
LOCAL_MODEL=qwen3-max

# 默认使用的模型 (qwen / local_qwen)
CRAWL_MODEL=local_qwen

# 视觉模型 (用于 PDF 解析)
VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen3-vl-flash
