# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key

# 本地/自定义 OpenAI 兼容模型
LOCAL_API_KEY=your-local-api-key
LOCAL_BASE_URL=http://your-server:8000/v1
LOCAL_MODEL=your-local-model-name

# 默认使用的模型 (deepseek / local_qwen)
CRAWL_MODEL=deepseek

# 视觉模型 (用于 PDF 解析；DeepSeek 官方暂无专用 VL，可换成其他兼容端点)
VL_API_KEY=
VL_BASE_URL=https://api.deepseek.com
VL_MODEL=deepseek-chat
